      "file": "apps/desktop/src/renderer/components/TeachingBookWorkspace.tsx",
      "name": "chooseBook",
      "ast": "async function chooseBook(bookId: string) {\n    if (bookId === selectedId && detail?.book.id === bookId) {\n        setEditorOpen(true);\n        return;\n    }\n    if (!allowDraftChange())\n        return;\n    activeBookId.current = bookId;\n    setEditorOpen(true);\n    setLoading(true);\n    try {\n        await loadBook(bookId);\n    }\n    catch (error) {\n        activeBookId.current = latest.current.detail?.book.id ?? '';\n        showError(error, '读取讲义失败，当前内容已保留，请重试。');\n    }\n    finally {\n        if (activeBookId.current === bookId || activeBookId.current === latest.current.detail?.book.id)\n            setLoading(false);\n    }\n}"
    },
    {
      "file": "apps/desktop/src/renderer/components/TeachingBookWorkspace.tsx",
      "name": "discardDrafts",
      "ast": "function discardDrafts() {\n    if (saving || loading)\n        return;\n    const snapshot = lastReadDetail.current?.book.id === detail?.book.id ? lastReadDetail.current : detail;\n    setDetail(snapshot);\n    resetDrafts(snapshot?.book);\n    setNotice('已明确放弃当前未保存修改，原保存记录与失败反馈保留。');\n}"
    },
    {
      "file": "apps/desktop/src/renderer/components/TeachingBookWorkspace.tsx",
      "name": "resetDrafts",
      "ast": "function resetDrafts(book?: TeachingBook) {\n    const next = teachingBookDraftBaseline(book);\n    setBookDraft(next.book);\n    setChapterDraft(next.chapter);\n    setPageDraft(next.page);\n    setBlockDraft(next.block);\n    setSourceDraft(next.source);\n    setPatchDraft(next.patch);\n    setSelectionPatchDraft(next.selection);\n    setEditingBlockId('');\n    setBookBaseline(next.book);\n    setBlockBaseline(next.block);\n    setPatchBaseline(next.patch);\n}"
    },
    {
      "file": "apps/desktop/src/renderer/components/TeachingBookWorkspace.tsx",
