      "ast": "function startNewBook() {\n    if (!selectedId && !detail) {\n        setEditorOpen(true);\n        return;\n    }\n    if (!allowDraftChange())\n        return;\n    ++requests.current.book;\n    ++requests.current.list;\n    activeBookId.current = '';\n    setSelectedId('');\n    setDetail(null);\n    lastReadDetail.current = null;\n    setPreview(null);\n    setInvalidations([]);\n    setPatches([]);\n    resetDrafts();\n    setPageChapterId('');\n    setBlockPageId('');\n    setEditorOpen(true);\n}"
